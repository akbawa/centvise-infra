PROJECT_NAME=centvise
ENV_NAME=stag
PROJECT_ROOT=/opt/centvise-manager

# Docker network and host bindings. Select an unused private subnet and ports.
DOCKER_SUBNET=172.31.99.0/24
BACKEND_PORT=127.0.0.1:4000
FRONTEND_PORT=127.0.0.1:3000

# Numeric owner of data/<environment>/backend-files on the VPS. When the
# deploy user creates this directory, use the output of: id -u; id -g
BACKEND_UID=10001
BACKEND_GID=10001

# Container registry credentials and image repositories.
CONTAINER_REGISTRY=ghcr.io
CONTAINER_REGISTRY_USER=replace-with-github-user
GHCR_PULL_TOKEN=replace-with-read-packages-token
BACKEND_IMAGE_REPOSITORY=ghcr.io/your-org/centvise-backend
FRONTEND_IMAGE_REPOSITORY=ghcr.io/your-org/centvise-frontend
BACKEND_IMAGE_TAG=staging-latest
FRONTEND_IMAGE_TAG=staging-latest

