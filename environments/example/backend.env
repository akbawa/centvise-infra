# Backend network contract inside the container.
HOST=0.0.0.0
PORT=4000

# Application and database URLs.
WHITELISTED_DOMAIN=https://app.example.com
CLIENT_URL=https://app.example.com
MONGO_URI=mongodb://username:password@host.docker.internal:27017/centvise?authSource=admin

# Authentication and required outbound email configuration.
JWT_SECRET=replace-with-a-strong-random-secret
BREVO_API_KEY=replace-with-brevo-api-key
EMAIL_SENDER=no-reply@example.com

# The application otherwise defaults PDF operations to Google Cloud Storage.
# This deployment persists generated files in the mounted VPS directory.
STORAGE_MODE=local
CENTVISE_STORAGE_ROOT=/var/lib/centvise

# Google sign-in and Gmail sending used by the backend.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GMAIL_OAUTH_REDIRECT_URI=https://api.example.com/auth/google/gmail/callback
GMAIL_OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-a-secret-at-least-32-characters
